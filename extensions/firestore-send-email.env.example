# Firebase Extensions: Trigger Email from Firestore 設定例
#
# Extension ID: firebase/firestore-send-email
# このファイルは設定値のサンプルです。実際の値は Firebase コンソールで設定するか、
# `extensions/firestore-send-email.env` として複製・編集してください
# （.env は秘匿情報を含む可能性があるため Git には含めない想定）。
#
# インストールコマンド例:
#   firebase ext:install firebase/firestore-send-email --project=YOUR_FIREBASE_PROJECT_ID
#
# 既に導入済みの場合は更新コマンド:
#   firebase ext:configure firestore-send-email --project=YOUR_FIREBASE_PROJECT_ID

# --- 監視対象コレクション ---------------------------------------------------
# Cloud Functions 側 (`functions/index.js`) でこのコレクション名にドキュメントを書き込む。
# 変更する場合は両方を揃える必要がある。
MAIL_COLLECTION=mail

# --- SMTP 接続情報 ---------------------------------------------------------
# Trigger Email Extension は SMTPS URI 形式で受け取る。
# 例 (SendGrid): smtps://apikey:SG.xxxxxxxx@smtp.sendgrid.net:465
# 例 (Mailgun) : smtps://postmaster%40mg.example.com:PASSWORD@smtp.mailgun.org:465
# 例 (Gmail)   : smtps://USER%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# 注意:
# - パスワードに記号 (@ : / 等) が含まれる場合は URL エンコードする。
# - 平文 SMTP (port 25/587) でも動くが、可能な限り 465/STARTTLS を使う。
SMTP_CONNECTION_URI=

# --- 送信元・宛先デフォルト ----------------------------------------------
# DEFAULT_FROM はメールの差出人として表示される。
# 表示名付き形式 (例: "Molkkynist <noreply@example.com>") も可。
DEFAULT_FROM=Molkkynist <noreply@example.com>

# DEFAULT_REPLY_TO は自動返信メールへの「返信」が届くアドレス。
# Cloud Functions 側で個別ドキュメントにも replyTo を付与しているため、
# 通常はそちらが優先される。
DEFAULT_REPLY_TO=info@groumapapp.com

# --- 配信時の運用設定 ------------------------------------------------------
# 配信成功・失敗ログを各ドキュメントの delivery フィールドに残す。
USERS_COLLECTION=

# テンプレート機能を使うかどうか (false にすると単純な message 構造のみ)
# 本プロジェクトでは Cloud Functions 側で HTML/TEXT を生成するため未使用。
TEMPLATES_COLLECTION=

# --- リージョン -------------------------------------------------------------
# Extension の実行リージョン。Cloud Functions (functions/index.js) と揃える。
LOCATION=asia-northeast1
