rules_version = '2';

// Molkkynist Firebase Storage セキュリティルール
//
// 方針:
// - 公開サイトで表示する管理画面登録画像は読み取り公開
// - アップロード・差し替え・削除は管理者 UID のみ
// - 初期実装では管理画面で扱う画像コレクション配下に限定する

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'PvM8qIBG1ETC2Y7qM3PFj1i2ASk2',
          'hvb1k4YC0ma98YsdlKU8DCEcqa63'
        ];
    }

    function isAllowedManagedImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function isManagedImageCollection(collectionId) {
      return collectionId in [
        'news',
        'venues',
        'reports'
      ];
    }

    match /{collectionId}/{documentId}/{fileName} {
      allow read: if isManagedImageCollection(collectionId);
      allow create, update: if isManagedImageCollection(collectionId)
        && isAdmin()
        && isAllowedManagedImage();
      allow delete: if isManagedImageCollection(collectionId) && isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
